# Copia este archivo como ".env" para desarrollo local (NUNCA subas el .env real a GitHub)

# Cadena de conexión a PostgreSQL. Cópiala desde tu proyecto en https://neon.tech
# (Panel del proyecto -> Connection string). No hace falta modificarla.
DATABASE_URL=postgres://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Contraseña de acceso a la aplicación
APP_PASSWORD=cambia-esto-por-una-contrasena-segura

# Clave secreta para firmar la sesión (usa un texto largo y aleatorio)
SESSION_SECRET=cambia-esto-por-un-texto-aleatorio-largo

# Puerto (Render lo asigna automáticamente, esto es solo para desarrollo local)
PORT=3000
